# ============================================================
# Vulcan Club — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to git.
# ============================================================

# --- Supabase (required for all functionality) ---
# Public values: safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_.
# Set this in Vercel and Render dashboards, not in this file.
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Vercel) ---
# Used for canonical URLs and Open Graph metadata.
# Set to your Vercel deployment URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the separately deployed backend API (Render service URL in production).
# Leave blank in local dev to use the Next.js API route fallback (/api/*).
# In production on Vercel, set this to: https://vulcan-club-api.onrender.com
# NEXT_PUBLIC_API_BASE_URL=https://vulcan-club-api.onrender.com

# --- Backend (Render server.mjs) ---
# PORT is injected automatically by Render — do not set it yourself.
# API_PORT is only used for local dev.
API_PORT=4000

# Comma-separated list of allowed CORS origins.
# In production, set this to your Vercel URL in the Render dashboard.
# e.g. FRONTEND_ORIGINS=https://vulcan-club.vercel.app,https://vulcanclub.org
FRONTEND_ORIGINS=http://localhost:3000

# --- Demo data (local development only) ---
# Set to true to show clearly labeled fictional preview data when Supabase is not configured.
USE_DEMO_DATA=false

# --- Optional social / contact links ---
# Leave blank until your accounts are set up.
NEXT_PUBLIC_CLUB_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
