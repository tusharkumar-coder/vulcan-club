# Public Supabase values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used for canonical URLs and Open Graph metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opt in to clearly labeled, fictional local preview records.
USE_DEMO_DATA=false

# Optional official contact/social configuration (leave blank until verified)
NEXT_PUBLIC_CLUB_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
